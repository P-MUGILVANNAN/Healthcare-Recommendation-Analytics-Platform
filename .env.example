# Application Runtime Configuration
ENVIRONMENT=development
PORT=8000
APP_NAME="Personalized Healthcare Recommendation Analytics"
APP_VERSION=1.2.0
SECRET_KEY=replace-with-your-secure-random-secret-key-32-chars

# MySQL Database Configuration
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:your_secure_password@127.0.0.1:3306/healthcare_analytics
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=healthcare_analytics

# CORS & Network Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
VITE_API_BASE_URL=/api
